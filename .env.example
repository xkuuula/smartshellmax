# SmartShell GraphQL API URL. If this endpoint does not work for your club,
# verify the GraphQL URL in the SmartShell web panel Network tab.
SMARTSHELL_API_URL=https://billing.smartshell.gg/api/graphql

# SmartShell account credentials. Use a dedicated integration account if possible.
SMARTSHELL_LOGIN=your_smartshell_login
SMARTSHELL_PASSWORD=your_smartshell_password
SMARTSHELL_COMPANY_ID=2803
SMARTSHELL_CLUB_TITLE=JustPlay
SMARTSHELL_TIMEZONE=Europe/Moscow

# Polling is limited by SmartShell public API limits. 15 seconds is 4 requests/minute.
SMARTSHELL_POLL_INTERVAL_SECONDS=15
SMARTSHELL_POLL_WINDOW_MINUTES=120
SMARTSHELL_WAREHOUSE_POLL_INTERVAL_SECONDS=300
SMARTSHELL_PAGE_SIZE=50
SMARTSHELL_MAX_PAGES_PER_POLL=3

# Leave SMARTSHELL_EVENT_TYPES empty to filter only by description keywords.
SMARTSHELL_EVENT_TYPES=

# Comma-separated text fragments. Leave empty and set SMARTSHELL_SEND_ALL_EVENTS=true
# to forward every SmartShell event returned by the API.
SMARTSHELL_DESCRIPTION_KEYWORDS=режим высокого доступа,восстановлена работа,Бонусное зачисление,Изменена конфигурация оборудования,списал товары со склада,оприходовал товары на склад,Новая конфигурация оборудования,расходный кассовый ордер,приходный кассовый ордер,Использована скидка,деактивирован шелл,начал рабочую смену,Возврат платежа,заканчивается,больше нет на складе,Новый отзыв о клубе,изменил депозит клиента,изменил бонусный счет клиента,изменил скидку клиента,не ответил на вызов
SMARTSHELL_SEND_ALL_EVENTS=false

# Access token of the MAX bot.
MAX_BOT_TOKEN=your_max_bot_token

# Numeric ID of the target MAX group or channel.
MAX_TARGET_CHAT_ID=-77153443244225

# Optional settings. The defaults below are ready for normal use.
MAX_API_BASE=https://platform-api2.max.ru
MAX_SSL_VERIFY=true
DATABASE_PATH=data/smartshell_max.db
LOG_FILE=service.log
LOG_LEVEL=INFO
RETENTION_DAYS=7
